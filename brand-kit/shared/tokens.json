  "gradient": {
    "$type": "gradient",
    "$description": "The single brand gradient. Use on primary actions and active states only — at most two occurrences per screen.",
    "brand": {
      "$value": [
        {
          "color": "{palette.emerald.500}",
          "position": 0
        },
        {
          "color": "{palette.cyan.500}",
          "position": 1
        }
      ],
      "$description": "135 degrees on web. Native platforms have no gradient angle concept; use this as a two-stop linear ramp instead."
    }
  },
