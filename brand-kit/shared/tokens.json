  "color": {
    "$type": "color",
    "$description": "Semantic colour roles. Components reference these, never the palette.",
    "dark": {
      "$description": "Default theme. Chosen first because the brand is dark-native.",
      "background": {
        "$value": "{palette.slate.950}",
        "$description": "The page. Never pure black — the blue undertone is what stops it reading as flat."
      },
      "surface": {
        "$value": "{palette.slate.900}",
        "$description": "Cards, inputs, navigation. One step up from background."
      },
      "surfaceRaised": {
        "$value": "{palette.slate.800}",
        "$description": "Chips, code blocks, menus. One step up again."
      },
      "border": {
        "$value": "{palette.slate.800}",
        "$description": "Default border. Interactive elements use borderStrong instead."
      },
      "borderStrong": {
        "$value": "{palette.slate.700}",
        "$description": "Interactive or focusable borders only."
      },
      "text": {
        "$value": "{palette.slate.100}",
        "$description": "Headings and emphasis. Too bright for body copy."
      },
      "textBody": {
        "$value": "{palette.slate.300}",
        "$description": "Body copy. This is the default reading colour."
      },
      "textMuted": {
        "$value": "{palette.slate.400}",
        "$description": "Labels, meta, captions. Not for paragraphs."
      },
      "brand": {
        "$value": "{palette.emerald.500}",
        "$description": "For borders, glows and fills — never for text."
      },
      "brandText": {
        "$value": "{palette.emerald.400}",
        "$description": "The only emerald permitted for text."
      },
      "accent": {
        "$value": "{palette.cyan.500}",
        "$description": "For borders, glows and fills — never for text."
      },
      "accentText": {
        "$value": "{palette.cyan.400}",
        "$description": "The only cyan permitted for text."
      },
      "warning": {
        "$value": "{palette.amber.500}",
        "$description": "Borders and fills."
      },
      "warningText": {
        "$value": "{palette.amber.400}",
        "$description": "Warning text."
      },
      "danger": {
        "$value": "{palette.rose.500}",
        "$description": "Destructive borders and fills."
      },
      "dangerText": {
        "$value": "{palette.rose.400}",
        "$description": "Destructive text."
      },
      "onBrand": {
        "$value": "{palette.slate.950}",
        "$description": "Text placed on the brand gradient or a solid brand fill."
      }
    },
