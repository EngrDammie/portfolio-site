{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Must match the Cloudflare project name and the WORKER_SELF_REFERENCE
	// service below. If these diverge, wrangler deploy fails with
	// "references Worker '<name>' which was not found [code: 10143]".
	"name": "get-tech-solutions",
	"compatibility_date": "2026-09-25",
	// Required: esbuild's keepNames helper (__name) leaks into the inline
	// scripts that next-themes emits into the SSR'd HTML, where nothing
	// defines it, throwing "Uncaught ReferenceError: __name is not defined"
	// in the browser. See https://opennext.js.org/cloudflare/howtos/keep_names
	// Requires wrangler >= 4.13.0.
	"keep_names": false,
	// nodejs_compat is required: it makes process.env.RESEND_API_KEY readable
	// in src/app/api/contact/route.ts. global_fetch_strictly_public allows the
	// Worker to call the Resend API.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Download click counting. Each app owns one key, "dl:<slug>", holding a
	// small JSON record of totals, per-day counts and referrer breakdown.
	// A namespace rather than a Worker route because OpenNext generates
	// .open-next/worker.js, so nothing hand-written survives a build.
	"kv_namespaces": [
		{
			"binding": "DOWNLOADS",
			"id": "cda89d6e87c941e3a521e2defa17b666"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "get-tech-solutions"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
